# API Neojapan
NODE_ENV=development
PORT=3002

# PostgreSQL — base de datos no usada por migraciones offline, requerida en runtime cuando DATA_STORE=database
DATABASE_URL=postgresql://usuario:password@localhost:5432/neojapan

# Store de datos: memory = demo sin DB (seed en memoria); database = Prisma real
DATA_STORE=memory

# CORS (coma-separado). Tienda y panel.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase Auth: use an asymmetric JWT signing key (ES256 or RS256).
SUPABASE_URL=https://<project-ref>.supabase.co/auth/v1
SUPABASE_SERVICE_ROLE_KEY=

# Desarrollo local sin Supabase: AUTH_DEMO_BYPASS=true deja pasar todas las
# rutas protegidas con una identidad de staff ficticia (NUNCA en producción).
AUTH_DEMO_BYPASS=false
# DEMO_STAFF_ID=10000000-0000-4000-8000-000000000001
# DEMO_STAFF_EMAIL=demo@neojapan.cl
# DEMO_STAFF_ROLE=ADMIN

# Optional environment variables for the staff-user script.
# STAFF_USER_EMAIL=
# STAFF_USER_PASSWORD=
# STAFF_USER_ROLE=ADMIN

# Signed Cloudinary preset: restrict to image formats and 10 MB maximum.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Pedidos online por WhatsApp
STORE_NAME=Neojapan
# Required to create an order; country code + number, digits only.
STORE_WHATSAPP_NUMBER=56957642162
STORE_BASE_URL=http://localhost:3000
RESERVATION_TTL_MINUTES=30
DISPATCH_BASE_PRICE=0
# Optional single-use storefront promotion configuration.
# STORE_COUPON_CODE=BIENVENIDA
# STORE_COUPON_PERCENT=10
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Must match REVALIDATE_SECRET in apps/web; generate a random secret with at least 32 characters.
# WEB_REVALIDATE_SECRET=change-this-local-token-to-a-random-secret-over-32-chars